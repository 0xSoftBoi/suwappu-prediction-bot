{
  "name": "suwappu-prediction-bot",
  "version": "2.0.0",
  "description": "Read-only prediction-market monitoring product built on Suwappu",
  "type": "module",
  "bin": { "suwappu-predict": "src/cli.ts" },
  "scripts": {
    "start": "bun run src/cli.ts browse",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "mkdir -p dist && bun build src/cli.ts --compile --outfile dist/suwappu-predict"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  },
  "engines": { "bun": ">=1.3.14" },
  "packageManager": "bun@1.3.14",
  "license": "MIT"
}
