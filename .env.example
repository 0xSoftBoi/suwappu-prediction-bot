# Public research commands do not require a key. Set this only for `positions`
# or `orders` (or when your deployment intentionally wants authenticated reads).
# SUWAPPU_API_KEY=suwappu_sk_your_api_key_here

# Optional development endpoint override.
# SUWAPPU_API_URL=https://api.suwappu.bot

# Bounded, retryable read policy.
# SUWAPPU_REQUEST_TIMEOUT_MS=20000
# SUWAPPU_READ_RETRIES=2

# Metadata-only API operation events on stderr (never IDs, keys, bodies, or queries).
# SUWAPPU_API_EVENTS=1

# Durable watch state. The container image defaults this to /data/state.
# SUWAPPU_PREDICTION_STATE_DIR=.suwappu-prediction
